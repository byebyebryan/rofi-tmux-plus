#!/usr/bin/env python3
"""Read-only verification of one installed Tmux Plus native/Observer artifact."""

import argparse
import json
import os
import subprocess
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prefix", type=Path, required=True)
    args = parser.parse_args()
    prefix = args.prefix.absolute()
    if not prefix.is_dir() or prefix.is_symlink() or prefix.stat().st_uid != os.getuid():
        raise ValueError("artifact_prefix_owner")
    code = (
        "import sys;sys.path.insert(0,sys.argv[1]);"
        "from rofi_tmux_plus.observer_client import observer_api;"
        "from rofi_tmux_plus.native_mode import verify_native;observer_api();verify_native()"
    )
    subprocess.run(
        ["python3", "-I", "-B", "-c", code, str(prefix)],
        check=True,
        capture_output=True,
        timeout=30,
    )
    print(
        json.dumps(
            {
                "status": "accepted",
                "prefix": str(prefix),
                "observerFacade": True,
                "nativeArtifact": True,
            }
        )
    )


if __name__ == "__main__":
    main()
