{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "meshRevision", "hosts"],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "generatedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "meshRevision": {"$ref": "common.schema.json#/$defs/nullableRevision"},
    "hosts": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/hostRow"}}
  }
}
