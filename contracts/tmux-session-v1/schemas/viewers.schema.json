{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewers.schema.json",
  "type": "object",
  "required": ["schemaVersion", "ok", "meshRevision", "sessionRef", "status", "viewers", "closeSafe"],
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "ok": {"type": "boolean", "const": true},
    "meshRevision": {"$ref": "common.schema.json#/$defs/nullableRevision"},
    "sessionRef": {"$ref": "common.schema.json#/$defs/reference"},
    "status": {"type": "string", "enum": ["none", "verified", "unverified", "ambiguous", "unsupported"]},
    "viewers": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["viewerId", "windowId"],
        "properties": {
          "viewerId": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^tv1_[A-Za-z0-9_-]{43}$"},
          "windowId": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
        }
      }
    },
    "closeSafe": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
