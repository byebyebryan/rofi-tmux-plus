      "stdoutBytes": 1048576
    },
    "open": {
      "argv": ["open", "--json"],
      "successSchema": "schemas/open.schema.json",
      "errorSchema": "schemas/error.schema.json",
      "successExit": 0,
      "errorExit": "nonzero",
      "stdoutBytes": 262144
    },
    "create": {
      "argv": ["create", "--json"],
      "successSchema": "schemas/create.schema.json",
      "errorSchema": "schemas/error.schema.json",
      "successExit": 0,
      "errorExit": "nonzero",
      "stdoutBytes": 262144
    },
    "rename": {
      "argv": ["rename", "--json"],
      "successSchema": "schemas/rename.schema.json",
      "errorSchema": "schemas/error.schema.json",
      "successExit": 0,
      "errorExit": "nonzero",
      "stdoutBytes": 262144
    },
    "kill": {
      "argv": ["kill", "--json"],
      "successSchema": "schemas/kill.schema.json",
