{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "ok": {
      "type": "boolean",
      "const": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/errorCode"
        },
        "message": {
          "$ref": "common.schema.json#/$defs/message"
        }
      }
    }
  }
}
